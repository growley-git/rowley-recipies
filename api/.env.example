DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="rowley-dev"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Set to 1 to enable stub AI tag suggestions and recipe summaries
AI_FEATURES=0

# Flat-file recipes (see content/README.md and ARCHITECTURE.md)
# RECIPE_SOURCE=db
# Path to the recipes directory (default: ../../content/recipes from apps/api cwd)
# CONTENT_DIR=
# RECIPE_SOURCE=files reads recipes from disk only (admin recipe/tag mutations disabled)
# CONTENT_HOT_RELOAD=1 re-reads recipe files on every request (file mode, dev only)
